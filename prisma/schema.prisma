generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model User {
  id           String    @id @default(cuid())
  email        String    @unique
  passwordHash String
  name         String
  role         String    @default("ADMIN") // ADMIN, TREASURER, COORDINATOR
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  payments     Payment[]
}

model PaymentPlan {
  id           String                @id @default(cuid())
  roleKey      String                @unique // JOVEN, DIRIGENTE, IST, CMT
  name         String
  totalAmount  Float                 // Total in USD
  currency     String                @default("USD")
  description  String?
  installments InstallmentSchedule[]
  participants Participant[]
  createdAt    DateTime              @default(now())
  updatedAt    DateTime              @updatedAt
}

model InstallmentSchedule {
  id                String      @id @default(cuid())
  planId            String
  plan              PaymentPlan @relation(fields: [planId], references: [id], onDelete: Cascade)
  installmentNumber Int
  title             String      // Ej: "Cuota 1 - Inscripción inicial"
  dueDate           DateTime
  amount            Float       // In USD
  createdAt         DateTime    @default(now())
  updatedAt         DateTime    @updatedAt

  @@unique([planId, installmentNumber])
}

model Participant {
  id                   String        @id @default(cuid())
  rut                  String        @unique
  rutClean             String?       // RUT sin puntos ni guión para búsquedas rápidas
  firstName            String
  lastName             String        // Primer Apellido
  secondLastName       String?       // Segundo Apellido
  email                String
  phone                String?
  birthDate            DateTime?
  gender               String?       // Masculino, Femenino, Otro
  address              String?       // Dirección
  commune              String?       // Comuna
  city                 String?       // Ciudad
  nationality          String?       // Nacionalidad
  secondNationality    String?       // Segunda nacionalidad
  idCardUrl            String?       // Enlace a imagen/Google Drive de la Cédula
  previousEvents       String?       // Eventos mundiales/interamericanos anteriores

  dietaryRestrictions String?
  medicalNotes         String?

  // Contacto de Emergencia / Apoderado
  guardianName         String?
  guardianRelationship String?
  guardianPhone        String?
  guardianEmail        String?

  // Información Scout AGSCH
  scoutZone            String?
  scoutDistrict        String?
  scoutGroup           String?
  scoutCurrentRole     String?       // Actualmente participando en (Guiadora, Dirigente, etc.)
  scoutTrainingLevel   String?       // Nivel de Formación
  scoutMemberNumber    String?       // N° de miembro activo
  groupLeaderName      String?       // Nombre Contacto Dirigente a cargo del Grupo
  groupLeaderEmail     String?       // Correo Contacto del Grupo
  groupLeaderPhone     String?       // Teléfono Contacto del Grupo
  activeRegistrations  String?       // Registro 2024, 2025, 2026, 2027

  // Datos en el Contingente Polonia 2027
  contingentRole       String        @default("Participante") // Participante, RESPONSABLE, IST, CMT, Responsable de Patrulla
  status               String        @default("CONFIRMADO")   // CONFIRMADO, PRE_INSCRITO, LISTA_ESPERA, RETIRADO / BAJA
  unitOrPatrol         String?

  // Asignaciones y Logística
  cupoCode             String?       // COD CUPO (Ej: IST106, PAR042)
  territorium          String?       // TERRITORIUM (Ej: SUR, NORTE, CENTRO)
  unit                 String?       // UNIT
  unitName             String?       // UNIT-NAME
  patrol               String?       // PATRULLA
  patrolName           String?       // PATROL-NAME
  patrolCode           String?       // COD PATRULLA
  uniformSize          String?       // TALLAS OK
  polandRegistered     String?       // REGISTRO POLAND (Sí / No)

  // Datos Financieros Oficiales del Sheet
  feeType              String?       // TIPO CUOTA (A: Inscripción Inicial, B: Temprana, etc.)
  feeEnrollmentType    String?       // TIPO INSCRIPCIÓN
  calendarUrl          String?       // URL imagen calendario de pagos
  totalPaidSheet       Float?        // CUOTA PAGADA según planilla
  targetFeeUSD         Float?        // CUOTA FINAL oficial en USD
  dueToDateUSD         Float?        // CUOTA A FECHA en USD
  debtFinalUSD         Float?        // DEUDA FINAL en USD
  debtToDateUSD        Float?        // DEUDA A FECHA en USD
  overpaymentUSD       Float?        // SOBREPAGO CUOTA en USD
  financialStatusSheet String?       // CUOTA AL DIA del Sheet ("Total Pagado", "Al Día", "Adeuda", "BAJA")

  // Plan Financiero y Pagos Relacionados
  planId               String?
  plan                 PaymentPlan?  @relation(fields: [planId], references: [id], onDelete: SetNull)
  payments             Payment[]

  notes                String?
  createdAt            DateTime      @default(now())
  updatedAt            DateTime      @updatedAt
}

model Payment {
  id                   String       @id @default(cuid())
  participantId        String
  participant          Participant  @relation(fields: [participantId], references: [id], onDelete: Cascade)
  amount               Float        // In USD
  paymentDate          DateTime     @default(now())
  paymentMethod        String       @default("TRANSFERENCIA") // TRANSFERENCIA, TARJETA, EFECTIVO, OTRO
  transactionReference String?      // N° de operación / Documento bancario
  notes                String?
  registeredById       String?
  registeredBy         User?        @relation(fields: [registeredById], references: [id], onDelete: SetNull)
  createdAt            DateTime     @default(now())
  updatedAt            DateTime     @updatedAt
}
