generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// -------------------------------------------------------------
// EVENTOS Y GESTIÓN MULTI-EVENTO
// -------------------------------------------------------------

model Event {
  id           String            @id @default(cuid())
  code         String            @unique // Ej: "WSJ-2027", "MOOT-2029", "PAXTU-2026"
  name         String            // Ej: "26° World Scout Jamboree • Polonia 2027"
  shortName    String?           // Ej: "Polonia 2027"
  type         String            @default("JAMBOREE_MUNDIAL") // JAMBOREE_MUNDIAL, MOOT_MUNDIAL, JAMBOREE_NACIONAL, etc.
  description  String?
  country      String?           // Ej: "Polonia"
  city         String?           // Ej: "Gdańsk"
  flagEmoji    String?           @default("🇵🇱") // Emoji de bandera o ícono
  startDate    DateTime?
  endDate      DateTime?
  currency     String            @default("USD") // "USD", "CLP", "EUR"
  isActive     Boolean           @default(true)
  isDefault    Boolean           @default(false)

  // Configuración de Identidad Visual
  themeColor   String?           @default("#001558")
  accentColor  String?           @default("#FEB135")
  bannerUrl    String?

  createdAt    DateTime          @default(now())
  updatedAt    DateTime          @updatedAt

  // Relaciones
  memberships   EventMembership[]
  plans         PaymentPlan[]
  participants  Participant[]
  emailAccounts EmailAccount[]
  emailMessages EmailMessage[]
  incidents     Incident[]
  receipts      PaymentReceipt[]
  kitItems      EventKitItem[]
}

model EventMembership {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  eventId   String
  event     Event    @relation(fields: [eventId], references: [id], onDelete: Cascade)
  role      String   @default("COORDINATOR") // EVENT_ADMIN, TREASURER, COORDINATOR, MEDICAL_STAFF, VIEWER
  title     String?  // Ej: "Jefe de Contingente", "Tesorero Nacional", "Encargado de Salud"
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([userId, eventId])
  @@index([userId])
  @@index([eventId])
}

// -------------------------------------------------------------
// USUARIOS Y AUTENTICACIÓN
// -------------------------------------------------------------

model User {
  id                String            @id @default(cuid())
  email             String            @unique
  passwordHash      String
  name              String
  role              String            @default("ADMIN") // SUPER_ADMIN, ADMIN, USER
  createdAt         DateTime          @default(now())
  updatedAt         DateTime          @updatedAt
  payments          Payment[]
  memberships       EventMembership[]
  assignedIncidents Incident[]        @relation("AssignedIncidents")
  createdIncidents  Incident[]        @relation("CreatedIncidents")
  incidentComments  IncidentComment[]
}

// -------------------------------------------------------------
// PLANES FINANCIEROS Y CUOTAS POR EVENTO
// -------------------------------------------------------------

model PaymentPlan {
  id           String                @id @default(cuid())
  eventId      String?
  event        Event?                @relation(fields: [eventId], references: [id], onDelete: Cascade)
  roleKey      String                // JOVEN, DIRIGENTE, IST, CMT
  name         String
  totalAmount  Float                 // Total en moneda del evento (ej: USD)
  currency     String                @default("USD")
  description  String?
  installments InstallmentSchedule[]
  participants Participant[]
  createdAt    DateTime              @default(now())
  updatedAt    DateTime              @updatedAt

  @@index([eventId])
}

model InstallmentSchedule {
  id                String      @id @default(cuid())
  planId            String
  plan              PaymentPlan @relation(fields: [planId], references: [id], onDelete: Cascade)
  installmentNumber Int
  title             String      // Ej: "Cuota 1 - Inscripción inicial"
  dueDate           DateTime
  amount            Float       // In USD
  createdAt         DateTime    @default(now())
  updatedAt         DateTime    @updatedAt

  @@unique([planId, installmentNumber])
}

// -------------------------------------------------------------
// MAESTRO DE PARTICIPANTES DEL EVENTO
// -------------------------------------------------------------

model Participant {
  id                   String        @id @default(cuid())
  eventId              String?
  event                Event?        @relation(fields: [eventId], references: [id], onDelete: Cascade)
  rut                  String        @unique
  rutClean             String?       // RUT sin puntos ni guión para búsquedas rápidas
  firstName            String
  lastName             String        // Primer Apellido
  secondLastName       String?       // Segundo Apellido
  email                String
  phone                String?
  birthDate            DateTime?
  gender               String?       // Masculino, Femenino, Otro
  address              String?       // Dirección
  commune              String?       // Comuna
  city                 String?       // Ciudad
  nationality          String?       // Nacionalidad
  secondNationality    String?       // Segunda nacionalidad
  idCardUrl            String?       // Enlace a imagen/Google Drive de la Cédula
  previousEvents       String?       // Eventos mundiales/interamericanos anteriores

  dietaryRestrictions String?
  medicalNotes         String?

  // Contacto de Emergencia / Apoderado
  guardianName         String?
  guardianRelationship String?
  guardianPhone        String?
  guardianEmail        String?

  // Información Scout AGSCH
  scoutZone            String?
  scoutDistrict        String?
  scoutGroup           String?
  scoutCurrentRole     String?       // Actualmente participando en (Guiadora, Dirigente, etc.)
  scoutTrainingLevel   String?       // Nivel de Formación
  scoutMemberNumber    String?       // N° de miembro activo
  groupLeaderName      String?       // Nombre Contacto Dirigente a cargo del Grupo
  groupLeaderEmail     String?       // Correo Contacto del Grupo
  groupLeaderPhone     String?       // Teléfono Contacto del Grupo
  activeRegistrations  String?       // Registro 2024, 2025, 2026, 2027

  // Datos en el Contingente / Evento
  contingentRole       String        @default("Participante") // Participante, RESPONSABLE, IST, CMT, Responsable de Patrulla
  status               String        @default("CONFIRMADO")   // CONFIRMADO, PRE_INSCRITO, LISTA_ESPERA, RETIRADO / BAJA
  unitOrPatrol         String?

  // Asignaciones y Logística
  cupoCode             String?       // COD CUPO (Ej: IST106, PAR042)
  territorium          String?       // TERRITORIUM (Ej: SUR, NORTE, CENTRO)
  unit                 String?       // UNIT
  unitName             String?       // UNIT-NAME
  patrol               String?       // PATRULLA
  patrolName           String?       // PATROL-NAME
  patrolCode           String?       // COD PATRULLA
  uniformSize          String?       // TALLAS OK
  polandRegistered     String?       // REGISTRO POLAND (Sí / No)

  // Datos Financieros Oficiales del Sheet
  feeType              String?       // TIPO CUOTA (A: Inscripción Inicial, B: Temprana, etc.)
  feeEnrollmentType    String?       // TIPO INSCRIPCIÓN
  calendarUrl          String?       // URL imagen calendario de pagos
  totalPaidSheet       Float?        // CUOTA PAGADA según planilla
  targetFeeUSD         Float?        // CUOTA FINAL oficial en USD
  dueToDateUSD         Float?        // CUOTA A FECHA en USD
  debtFinalUSD         Float?        // DEUDA FINAL en USD
  debtToDateUSD        Float?        // DEUDA A FECHA en USD
  overpaymentUSD       Float?        // SOBREPAGO CUOTA en USD
  financialStatusSheet String?       // CUOTA AL DIA del Sheet ("Total Pagado", "Al Día", "Adeuda", "BAJA")

  // Plan Financiero y Pagos Relacionados
  planId               String?
  plan                 PaymentPlan?  @relation(fields: [planId], references: [id], onDelete: SetNull)
  payments             Payment[]

  // Ficha Médica WSJ
  medicalRecord        MedicalRecord?

  // Comunicaciones e Incidencias CRM
  emailMessages        EmailMessage[]
  incidents            Incident[]

  // Portal del Participante y Kit
  magicLinks           ParticipantMagicLink[]
  kitSizes             ParticipantKitSize[]

  notes                String?
  createdAt            DateTime      @default(now())
  updatedAt            DateTime      @updatedAt

  @@index([eventId])
  @@index([rut])
  @@index([rutClean])
  @@index([email])
}

// -------------------------------------------------------------
// FICHA MÉDICA CLÍNICA Y CÓDIGOS OTP
// -------------------------------------------------------------

model MedicalRecord {
  id                                String      @id @default(cuid())
  participantId                     String      @unique
  participant                       Participant @relation(fields: [participantId], references: [id], onDelete: Cascade)
  qrAccessCode                      String      @unique @default(cuid()) // Token público para acceso médico de emergencia por QR

  // Datos biométricos y tipo de sangre
  bloodType                         String?     // O+, O-, A+, A-, B+, B-, AB+, AB-
  heightCm                          Float?
  weightKg                          Float?

  // Contacto de Emergencia
  emergencyContactName              String?
  emergencyContactPhone             String?
  emergencyContactRelation          String?
  emergencyContactEmail             String?

  // Seguro Médico Internacional de Viaje
  insuranceCompany                  String?
  insurancePolicyNumber             String?
  insuranceEmergencyPhone           String?

  // Alergias
  hasSevereAllergies                Boolean     @default(false)
  carriesEpiPen                     Boolean     @default(false)
  allergiesES                       String?
  allergiesEN                       String?
  allergiesPL                       String?

  // Condiciones Médicas / Enfermedades Crónicas
  hasChronicConditions              Boolean     @default(false)
  chronicConditionsES               String?
  chronicConditionsEN               String?
  chronicConditionsPL               String?

  // Medicación habitual
  takesRegularMedication            Boolean     @default(false)
  requiresColdChainMedication       Boolean     @default(false)
  currentMedicationsES              String?
  currentMedicationsEN              String?
  currentMedicationsPL              String?

  // Restricciones Dietarias / Intolerancias
  dietaryRestrictionsES            String?
  dietaryRestrictionsEN            String?
  dietaryRestrictionsPL            String?

  // Vacunación
  tetanusLastDoseYear               String?
  vaccinationRecordsES              String?
  vaccinationRecordsEN              String?
  vaccinationRecordsPL              String?

  // Cirugías, Traumatismos y Antecedentes
  pastSurgeriesInjuriesES            String?
  pastSurgeriesInjuriesEN            String?
  pastSurgeriesInjuriesPL            String?

  // Dispositivos Médicos / Ópticos / Auditivos
  devicesImplantsES                 String?
  devicesImplantsEN                 String?
  devicesImplantsPL                 String?

  // Limitaciones para actividades físicas / acuáticas en campamento
  physicalLimitationsES             String?
  physicalLimitationsEN             String?
  physicalLimitationsPL             String?

  // Declaración y Consentimiento de Emergencia en Polonia
  emergencyTreatmentConsent         Boolean     @default(false)
  declaredByName                    String?
  declaredByRut                     String?
  declaredByRole                    String?     // APODERADO / PARTICIPANTE_ADULTO
  declaredAt                        DateTime?

  completionStatus                  String      @default("PENDING") // PENDING, COMPLETED, VERIFIED
  lastUpdatedIp                     String?

  createdAt                         DateTime    @default(now())
  updatedAt                         DateTime    @updatedAt
}

model MedicalVerificationCode {
  id            String    @id @default(cuid())
  participantId String
  email         String
  code          String    // Código OTP de 6 dígitos
  expiresAt     DateTime
  usedAt        DateTime?
  ipAddress     String?
  createdAt     DateTime  @default(now())

  @@index([participantId, email])
}

// -------------------------------------------------------------
// HISTORIAL DE PAGOS
// -------------------------------------------------------------

model Payment {
  id                   String       @id @default(cuid())
  participantId        String
  participant          Participant  @relation(fields: [participantId], references: [id], onDelete: Cascade)
  amount               Float        // En moneda del evento (USD)
  paymentDate          DateTime     @default(now())
  paymentMethod        String       @default("TRANSFERENCIA") // TRANSFERENCIA, TARJETA, EFECTIVO, TRASPASO, DEVOLUCION, OTRO
  transactionReference String?      // N° de operación / Documento bancario
  receiptUrl           String?      // URL del comprobante adjunto (ej: S3 de Fillout)
  filloutSubmissionId  String?      @unique // ID único de envío en Fillout para idempotencia del webhook
  source               String?      @default("MANUAL") // MANUAL, CSV_SHEET, FILLOUT_MAIN, FILLOUT_SUBFORM
  notes                String?
  registeredById       String?
  registeredBy         User?        @relation(fields: [registeredById], references: [id], onDelete: SetNull)
  createdAt            DateTime     @default(now())
  updatedAt            DateTime     @updatedAt

  @@index([participantId])
  @@index([transactionReference])
}

model PaymentReceipt {
  id        String   @id @default(cuid())
  eventId   String
  event     Event    @relation(fields: [eventId], references: [id], onDelete: Cascade)
  fileName  String
  mimeType  String
  sizeBytes Int
  content   Bytes
  createdAt DateTime @default(now())

  @@index([eventId])
}

// -------------------------------------------------------------
// COMUNICACIONES POR CORREO (GOOGLE / INBOX)
// -------------------------------------------------------------

model EmailAccount {
  id           String         @id @default(cuid())
  eventId      String
  event        Event          @relation(fields: [eventId], references: [id], onDelete: Cascade)
  email        String
  provider     String         @default("GOOGLE") // GOOGLE, IMAP, SIMULATOR
  accessToken  String?
  refreshToken String?
  tokenExpiry  DateTime?
  syncStatus   String         @default("IDLE") // IDLE, SYNCING, ERROR, SUCCESS
  lastSyncedAt DateTime?
  lastError    String?
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt
  messages     EmailMessage[]

  @@unique([eventId, email])
}

model EmailMessage {
  id              String        @id @default(cuid())
  eventId         String
  event           Event         @relation(fields: [eventId], references: [id], onDelete: Cascade)
  accountId       String?
  account         EmailAccount? @relation(fields: [accountId], references: [id], onDelete: SetNull)

  // Datos específicos de Google / Gmail
  googleMessageId String?       @unique // ID del mensaje en Gmail
  googleThreadId  String?               // ID del hilo de conversación en Gmail

  senderEmail     String
  senderName      String?
  recipientEmail  String?
  subject         String
  snippet         String?
  bodyText        String?
  bodyHtml        String?
  date            DateTime
  hasAttachments  Boolean       @default(false)
  labels          String?               // JSON o tags (INBOX, UNREAD, IMPORTANT, etc.)

  // Asociación Inteligente al Participante
  participantId   String?
  participant     Participant?  @relation(fields: [participantId], references: [id], onDelete: SetNull)
  matchMethod     String?               // EXACT_EMAIL, GUARDIAN_EMAIL, RUT_MATCH, MANUAL

  // Vinculación a Incidencia / Ticket
  ticketId        String?
  ticket          Incident?     @relation(fields: [ticketId], references: [id], onDelete: SetNull)

  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  @@index([eventId])
  @@index([googleThreadId])
  @@index([participantId])
  @@index([senderEmail])
}

// -------------------------------------------------------------
// GESTIÓN DE INCIDENCIAS, CASOS Y TICKETS CRM
// -------------------------------------------------------------

model Incident {
  id              String            @id @default(cuid())
  ticketNumber    String            @unique // Ej: "INC-2027-001"
  eventId         String
  event           Event             @relation(fields: [eventId], references: [id], onDelete: Cascade)
  participantId   String
  participant     Participant       @relation(fields: [participantId], references: [id], onDelete: Cascade)

  title           String
  description     String
  category        String            @default("CONSULTA_GENERAL") // FINANZAS, FICHA_MEDICA, PASAJES_LOGISTICA, CEDULA_LEGAL, CONSULTA_GENERAL
  priority        String            @default("MEDIA")            // URGENTE, ALTA, MEDIA, BAJA
  status          String            @default("ABIERTA")          // ABIERTA, EN_PROCESO, ESPERANDO_RESPUESTA, RESUELTA, CERRADA

  assignedToId    String?
  assignedTo      User?             @relation("AssignedIncidents", fields: [assignedToId], references: [id], onDelete: SetNull)
  createdById     String?
  createdBy       User?             @relation("CreatedIncidents", fields: [createdById], references: [id], onDelete: SetNull)

  resolutionNotes String?
  resolvedAt      DateTime?

  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt

  messages        EmailMessage[]
  comments        IncidentComment[]

  @@index([eventId])
  @@index([participantId])
  @@index([status])
  @@index([category])
}

model IncidentComment {
  id         String   @id @default(cuid())
  incidentId String
  incident   Incident @relation(fields: [incidentId], references: [id], onDelete: Cascade)
  userId     String?
  user       User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  authorName String
  content    String
  isInternal Boolean  @default(true)
  createdAt  DateTime @default(now())

  @@index([incidentId])
}

// -------------------------------------------------------------
// PORTAL DEL PARTICIPANTE (MAGIC LINKS Y KIT / TALLAS)
// -------------------------------------------------------------

model ParticipantMagicLink {
  id            String      @id @default(cuid())
  participantId String
  participant   Participant @relation(fields: [participantId], references: [id], onDelete: Cascade)
  email         String
  tokenHash     String      @unique
  expiresAt     DateTime
  usedAt        DateTime?
  ipAddress     String?
  userAgent     String?
  createdAt     DateTime    @default(now())

  @@index([participantId])
  @@index([email])
  @@index([expiresAt])
}

model EventKitItem {
  id               String               @id @default(cuid())
  eventId          String
  event            Event                @relation(fields: [eventId], references: [id], onDelete: Cascade)
  code             String
  name             String
  category         String               @default("SUPERIOR")
  description      String?
  availableSizes   String
  availableFits    String?
  sizeGuideJson    String?
  includedQuantity Int                  @default(1)
  isRequired       Boolean              @default(true)
  isActive         Boolean              @default(true)
  sortOrder        Int                  @default(0)
  createdAt        DateTime             @default(now())
  updatedAt        DateTime             @updatedAt
  selections       ParticipantKitSize[]

  @@unique([eventId, code])
  @@index([eventId])
}

model ParticipantKitSize {
  id            String       @id @default(cuid())
  participantId String
  participant   Participant  @relation(fields: [participantId], references: [id], onDelete: Cascade)
  kitItemId     String
  kitItem       EventKitItem @relation(fields: [kitItemId], references: [id], onDelete: Cascade)
  size          String
  fit           String?
  notes         String?
  confirmedAt   DateTime     @default(now())
  updatedAt     DateTime     @updatedAt

  @@unique([participantId, kitItemId])
  @@index([participantId])
  @@index([kitItemId])
}
